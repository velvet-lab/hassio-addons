#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash

root=/data
gogs_root="$root/gogs"
config_root="$gogs_root/config"
homeassistant_root="/homeassistant"
user_config_root="$homeassistant_root/addons/gogs"
user_config="$user_config_root/gogs.ini"

# Set Log Level
bashio::log.level "$(bashio::config 'log_level' 'info')"

# Render the final Gogs configuration from the user-edited file. The secret is
# expanded here (not in gogs-pre) because with-contenv loads the s6 container
# environment (/var/run/s6/container_environment/*) only at script start.
# gogs-pre writes GOGS_SECRET_KEY there, so at this point an envsubst can pick
# it up along with any other container-environment variables.
bashio::log.debug "Write Gogs configuration"
envsubst < "${user_config}" > "${config_root}/app.ini"
chmod 644 "${config_root}/app.ini"

bashio::log.info "Start Gogs ..."
exec gogs web --config=/data/gogs/config/app.ini