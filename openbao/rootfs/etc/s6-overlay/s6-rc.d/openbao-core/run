#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash

# Config location comes from the container environment (set by openbao-pre).
# It is REQUIRED: abort if missing instead of falling back to a default.
# shellcheck disable=SC2153  # APP_CONFIG_DEST is a container-env var set by with-contenv
config_dest="${APP_CONFIG_DEST:?APP_CONFIG_DEST is not set (openbao-pre did not run)}"

# Set Log Level
bashio::log.level "$(bashio::config 'log_level' 'info')"

bashio::log.info "Start OpenBao ..."
exec bao server -config=${config_dest}
