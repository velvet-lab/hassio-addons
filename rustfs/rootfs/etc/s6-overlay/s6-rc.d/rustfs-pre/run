#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
root=/data
data_root="$root/rustfs"
log_root="$root/logs"

default_log_level="info"

# Set Log Level
log_level=$(bashio::config 'log_level' "$default_log_level")
bashio::log.level "$log_level"

bashio::log.info "Starting Conduit pre-initialization script..."

bashio::log.debug "Ensuring data directory exists..."
if ! bashio::fs.directory_exists "$data_root"; then
    mkdir -p "$data_root"
    chmod 755 "$data_root"
fi

if ! bashio::fs.directory_exists "$log_root"; then
    mkdir -p "$log_root"
    chmod 755 "$log_root"
fi

bashio::log.debug "Reading configuration options..."
access_key=$(bashio::config 'access_key')
secret_key=$(bashio::config 'secret_key')
console_enable=$(bashio::config 'console_enable' true)

bashio::log.debug "Preparing and validating environment variables..."
bashio::config.require 'access_key' "Access Key is not set in the configuration"
bashio::config.require 'secret_key' "Secret Key is not set in the configuration"

bashio::log.debug "Set environment variables for conduit..."
echo -n "${access_key}" > "/var/run/s6/container_environment/RUSTFS_ACCESS_KEY"
echo -n "${secret_key}" > "/var/run/s6/container_environment/RUSTFS_SECRET_KEY"
echo -n "${console_enable}" > "/var/run/s6/container_environment/RUSTFS_CONSOLE_ENABLE"
echo -n "${log_level}" > "/var/run/s6/container_environment/RUST_LOG"
echo -n "${log_root}" > "/var/run/s6/container_environment/RUSTFS_OBS_LOG_DIRECTORY"
echo -n ":9000" > "/var/run/s6/container_environment/RUSTFS_ADDRESS"

bashio::log.debug "Redirect log output"
rm -f "${root}/app.err"
ln -s /proc/1/fd/1 "${root}/app.err"
