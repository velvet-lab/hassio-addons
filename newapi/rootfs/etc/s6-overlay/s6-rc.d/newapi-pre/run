#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash

# Static, unique build marker. Bump this value on every code change so we can
# verify from the log whether the container image was actually rebuilt and is
# not a stale cache. If the marker is NOT visible in the log, the image is old.
readonly build_marker="newapi-build-v7-app-symlinks"

root=/data
app_name="newapi"
data_root="$root/${app_name}"
homeassistant_root="/homeassistant"
config_source="$homeassistant_root/addons/${app_name}"
config_dest="/etc/${app_name}"
user_config="$config_source/newapi.env"

default_log_level="info"

log_level=$(bashio::config 'log_level' "$default_log_level")
bashio::log.level "${log_level}"

bashio::log.info "New API build marker: ${build_marker}"
bashio::log.info "Prepare New API configuration"

# Expose the app identity and config locations via the s6 container
# environment (one file per variable). The core service reads them via
# with-contenv to render and load the configuration.
echo -n "${app_name}" > /var/run/s6/container_environment/APP_NAME
echo -n "${config_source}" > /var/run/s6/container_environment/APP_CONFIG_SOURCE
echo -n "${config_dest}" > /var/run/s6/container_environment/APP_CONFIG_DEST

bashio::log.debug "Create folders"
for folder in "${data_root}" "${config_source}" "${config_dest}"; do
    if ! bashio::fs.directory_exists "${folder}"; then
        bashio::log.debug "Creating folder ${folder}"
        mkdir -p "${folder}"
        chmod 755 "${folder}"
    fi
done

# New API refuses to start when SESSION_SECRET is the literal string
# "random_string" and generates a fresh random value on every start when it is
# unset. The `session_secret` setting is a REQUIRED add-on option (Home
# Assistant stores it encrypted). Instead of generating a secret on first start,
# abort startup if the user has not provided one — a generated key would diverge
# from the value in the user's configuration and break sessions after a restart.
if ! bashio::var.has_value "$(bashio::config 'session_secret')"; then
    bashio::log.error "The 'session_secret' option is required but empty."
    bashio::log.error "Set a strong random value, e.g. generated with:"
    bashio::log.error "    openssl rand -hex 64"
    bashio::log.error "and restart the add-on."
    exit 1
fi

bashio::log.debug "Using the session_secret from the add-on configuration"
session_secret="$(bashio::config 'session_secret')"

# Export the secret via the s6 container environment so the longrun service
# can inherit it regardless of the .env file.
echo -n "${session_secret}" > /var/run/s6/container_environment/SESSION_SECRET
unset session_secret

# CRYPTO_SECRET is required for HMAC signing of cache keys. New API defaults
# to SESSION_SECRET when CRYPTO_SECRET is unset, but in multi-node deployments
# all nodes sharing Redis must use the same value. Treat it as a required option.
if ! bashio::var.has_value "$(bashio::config 'crypto_secret')"; then
    bashio::log.error "The 'crypto_secret' option is required but empty."
    bashio::log.error "Set a strong random value, e.g. generated with:"
    bashio::log.error "    openssl rand -hex 64"
    bashio::log.error "and restart the add-on."
    exit 1
fi

bashio::log.debug "Using the crypto_secret from the add-on configuration"
crypto_secret="$(bashio::config 'crypto_secret')"

echo -n "${crypto_secret}" > /var/run/s6/container_environment/CRYPTO_SECRET
unset crypto_secret

# Timezone configuration (optional, defaults to Etc/UTC).
tz=$(bashio::config 'tz' 'Etc/UTC')
[[ "${tz}" == "null" ]] && tz="Etc/UTC"
echo -n "${tz}" > /var/run/s6/container_environment/NEWAPI_TZ

# Frontend base URL (optional) for slave nodes / redirects.
frontend_base_url=$(bashio::config 'frontend_base_url')
[[ "${frontend_base_url}" == "null" ]] && frontend_base_url=""
echo -n "${frontend_base_url}" > /var/run/s6/container_environment/NEWAPI_FRONTEND_BASE_URL

# On first start copy the default configuration template to the user-accessible
# folder under /homeassistant, where the user can edit it (e.g. with VS Code).
# If the user deletes the file it is recreated from the bundled template.
if ! bashio::fs.file_exists "${user_config}"; then
    bashio::log.info "Creating default New API configuration for the user"
    cp /etc/default/newapi.env "${user_config}"
    chmod 644 "${user_config}"
fi

# Export paths for template rendering
echo -n "${data_root}" > /var/run/s6/container_environment/NEWAPI_DATA_DIR
echo -n "${data_root}/one-api.db" > /var/run/s6/container_environment/NEWAPI_SQLITE_PATH

# Database backend. By default New API uses the bundled SQLite database file.
# When the use_mysql option is enabled, New API instead uses the MySQL/MariaDB
# service provided by another add-on. The resolved DSN is exported so the core
# service can render it into the SQL_DSN line of the .env file.
sql_dsn=""

use_mysql=$(bashio::config 'use_mysql' false)

if bashio::var.true "${use_mysql}"; then
    db_hostname=$(bashio::services "mysql" "host")
    db_host_ipv4=$(dig +short A "${db_hostname}" | head -1)
    db_port=$(bashio::services "mysql" "port")
    db_password=$(bashio::services "mysql" "password")
    db_user=$(bashio::services "mysql" "username")

    bashio::log.debug "Connecting to MariaDB at ${db_host_ipv4}:${db_port} with user ${db_user}"

    # Create the New API database if it does not exist yet. New API's MySQL DSN
    # (user:pass@tcp(host:port)/db) points at the database, so it must exist
    # before the app starts.
    mariadb -u "${db_user}" -p"${db_password}" -h "${db_host_ipv4}" -P "${db_port}" --skip-ssl \
        -e "CREATE DATABASE IF NOT EXISTS \`new-api\` CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;"

    sql_dsn="${db_user}:${db_password}@tcp(${db_host_ipv4}:${db_port})/new-api"

    bashio::log.warning "New API is using the MariaDB add-on for its database"
    bashio::log.warning "Please ensure this is included in your backups"
    bashio::log.warning "Uninstalling the MariaDB add-on will remove any data"
else
    bashio::log.debug "Using the built-in SQLite database"
fi

echo -n "${sql_dsn}" > /var/run/s6/container_environment/NEWAPI_SQL_DSN

# Optional Redis-compatible cache. Redis is configured through the add-on
# options redis_host / redis_port / redis_password. As soon as any one of them
# is set, host and password are required; when all are left empty, Redis is
# disabled (New API falls back to its in-memory cache).
redis_host=$(bashio::config 'redis_host')
redis_password=$(bashio::config 'redis_password')
# redis_port / redis_username / redis_db are prefilled with defaults in the UI
# options, so they always have a value. They are NOT indicators for Redis being
# used — only redis_host or redis_password are.
redis_port=$(bashio::config 'redis_port' '6379')
redis_username=$(bashio::config 'redis_username' 'default')
redis_db=$(bashio::config 'redis_db' '0')

# bashio returns the literal string "null" when an optional schema option is
# unset (not an empty value). Normalize host/password (the indicators) and the
# prefilled values to their defaults.
[[ "${redis_host}" == "null" ]] && redis_host=""
[[ "${redis_password}" == "null" ]] && redis_password=""
[[ "${redis_port}" == "null" ]] && redis_port="6379"
[[ "${redis_username}" == "null" ]] && redis_username="default"
[[ "${redis_db}" == "null" ]] && redis_db="0"

# Redis is considered active when redis_host OR redis_password is set. The three
# prefilled values (redis_port / redis_username / redis_db) are no indicator on
# their own. Once active, both redis_host and redis_password are required.
redis_conn_string=""
if bashio::var.has_value "${redis_host}" \
    || bashio::var.has_value "${redis_password}"; then
    if ! bashio::var.has_value "${redis_host}"; then
        bashio::log.error "The 'redis_host' option is required when Redis is configured."
        bashio::log.error "Set 'redis_host' and 'redis_password' (or leave both empty to disable Redis)."
        exit 1
    fi
    if ! bashio::var.has_value "${redis_password}"; then
        bashio::log.error "The 'redis_password' option is required when Redis is configured."
        bashio::log.error "Set 'redis_host' and 'redis_password' (or leave both empty to disable Redis)."
        exit 1
    fi

    # Build the redis:// URI that New API parses (redis://user:password@host:port/db).
    # The username (default "default") is always included and the DB index comes
    # from the redis_db option so each app can use its own database.
    redis_conn_string="redis://${redis_username}:${redis_password}@${redis_host}:${redis_port}/${redis_db}"

    bashio::log.info "New API will use a Redis server at ${redis_host}:${redis_port} (db ${redis_db})"
else
    bashio::log.debug "Redis is disabled; using the in-memory cache"
fi

echo -n "${redis_conn_string}" > /var/run/s6/container_environment/NEWAPI_REDIS_CONN_STRING

bashio::log.debug "Redirect log output"
rm -f "${root}/app.err"
ln -s /proc/1/fd/1 "${root}/app.err"

# s6 oneshot services MUST end with exit 0, otherwise s6 treats them as
# "unable to start service ... command exited N" and aborts the whole container
# bring-up (rc.init: fatal: stopping the container).
exit 0