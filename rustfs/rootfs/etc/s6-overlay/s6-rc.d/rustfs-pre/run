#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
root=/data
data_root="$root/rustfs"
log_root="$root/logs"

default_log_level="info"

# Set Log Level
log_level=$(bashio::config 'log_level' "$default_log_level")
bashio::log.level "$log_level"

bashio::log.info "Starting rustfs pre-initialization script..."

bashio::log.debug "Ensuring data directory exists..."
if ! bashio::fs.directory_exists "$data_root"; then
    mkdir -p "$data_root"
    chmod 755 "$data_root"
fi

if ! bashio::fs.directory_exists "$log_root"; then
    mkdir -p "$log_root"
    chmod 755 "$log_root"
fi

bashio::log.debug "Reading configuration options..."
access_key=$(bashio::config 'access_key')
secret_key=$(bashio::config 'secret_key')
console_enable=$(bashio::config 'console_enable' true)

bashio::log.debug "Preparing and validating environment variables..."
bashio::config.require 'access_key' "Access Key is not set in the configuration"
bashio::config.require 'secret_key' "Secret Key is not set in the configuration"

if [ "$log_level" == "warning" ]; then
    log_level="warn"
fi

bashio::log.debug "Set environment variables for rustfs..."
echo -n "${access_key}" > "/var/run/s6/container_environment/RUSTFS_ACCESS_KEY"
echo -n "${secret_key}" > "/var/run/s6/container_environment/RUSTFS_SECRET_KEY"

echo -n "${console_enable}" > "/var/run/s6/container_environment/RUSTFS_CONSOLE_ENABLE"

# echo -n "rustfs=${log_level}" > "/var/run/s6/container_environment/RUSTFS_LOG_LEVEL"
# echo -n "${log_root}" > "/var/run/s6/container_environment/RUSTFS_SINKS_FILE_PATH"
# echo -n "1" > "/var/run/s6/container_environment/RUSTFS_BACKTRACE"
# echo -n "s3.x-homelab.de" > "/var/run/s6/container_environment/RUSTFS_SERVER_DOMAINS"

echo -n "*" > "/var/run/s6/container_environment/RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS"
echo -n "*" > "/var/run/s6/container_environment/RUSTFS_CORS_ALLOWED_ORIGINS"

echo -n ":9000" > "/var/run/s6/container_environment/RUSTFS_ADDRESS"
echo -n ":9001" > "/var/run/s6/container_environment/RUSTFS_CONSOLE_ADDRESS"

echo -n "${log_level}" > "/var/run/s6/container_environment/RUSTFS_OBS_LOGGER_LEVEL"
echo -n "${log_root}" > "/var/run/s6/container_environment/RUSTFS_OBS_LOG_DIRECTORY"
# echo -n "production" > "/var/run/s6/container_environment/RUSTFS_OBS_ENVIRONMENT"

bashio::log.debug "Redirect log output"
rm -f "${root}/app.err"
ln -s /proc/1/fd/1 "${root}/app.err"

bashio::log.debug "Configure Nginx to log to stdout"
sed -i 's|error_log /var/log/nginx/error\.log;|error_log /proc/1/fd/1 error;|' /etc/nginx/nginx.conf
