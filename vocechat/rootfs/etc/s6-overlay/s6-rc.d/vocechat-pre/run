NEW_INSTALL=false
if ! bashio::fs.directory_exists "${DATA_ROOT}/db"; then
    NEW_INSTALL=true
fi

bashio::log.info "Load variables"
DOMAIN=$(bashio::config 'domain' 'homeassistant.local') && bashio::log.info 'Network Domain set'

TOKEN_EXPIRY_SECONDS=$(bashio::config 'token_expiry_seconds' '300') && bashio::log.info 'Token expiry seconds set'
REFRESH_TOKEN_EXPIRY_SECONDS=$(bashio::config 'refresh_token_expiry_seconds' '864000000') && bashio::log.info 'Refresh token expiry seconds set'
MAGIC_TOKEN_EXPIRY_SECONDS=$(bashio::config 'magic_token_expiry_seconds' '600') && bashio::log.info 'Magic token expiry token set'

TEMPLATE_REGISTER_BY_MAIL=$(bashio::config 'template_register_by_email' 'Register code') && bashio::log.info 'Subject for register set'
TEMPLATE_LOGIN_BY_MAIL=$(bashio::config 'template_login_by_email' 'Your sign-in link for Vocechat') && bashio::log.info 'Subject for login set'

bashio::log.debug "Save variables"
