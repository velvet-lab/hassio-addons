#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash

# Config location comes from the container environment (set by neo4j-pre).
# It is REQUIRED: abort if missing instead of falling back to a default.
# shellcheck disable=SC2153  # APP_CONFIG_DEST is a container-env var set by with-contenv
config_dest="${APP_CONFIG_DEST:?APP_CONFIG_DEST is not set (neo4j-pre did not run)}"

bashio::log.info "Start Neo4j ..."

cd /opt/neo4j || exit 1

bashio::log.debug "Neo4j build marker: neo4j-build-v1"
exec /opt/neo4j/bin/neo4j console --home /opt/neo4j --config "${config_dest}/neo4j.conf"
