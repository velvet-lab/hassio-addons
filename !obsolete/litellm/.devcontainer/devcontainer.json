{
  "name": "LiteLLM Add-on Development",
  "build": {
    "dockerfile": "../Dockerfile",
    "args": {
      "BUILD_FROM": "ghcr.io/home-assistant/amd64-base-debian:trixie",
      "BUILD_ARCH": "amd64",
      "LITELLM_VERSION": "v1.98.0-stable"
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/mounts/data,target=/data,type=bind",
    "source=${localWorkspaceFolder}/.devcontainer/mounts/config,target=/homeassistant,type=bind"
  ],
  "privileged": true,
  "init": true,
  "forwardPorts": [4000],
  "portsAttributes": {
    "4000": {
      "label": "LiteLLM Proxy + Dashboard",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "postAttachCommand": "bash .devcontainer/post-attach.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
