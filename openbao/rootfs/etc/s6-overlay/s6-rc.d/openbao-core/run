#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash

# Set Log Level
bashio::log.level "$(bashio::config 'log_level' 'info')"

# OpenBao API address (local, plain HTTP)
export BAO_ADDR="http://127.0.0.1:8200"

# Persistent folder for secrets
data_root="/data/openbao"
secrets_file="${data_root}/unseal.keys"
init_endpoint="${BAO_ADDR}/v1/sys/init"

bashio::log.info "Start OpenBao ..."
bao server -config=/data/openbao/config &
server_pid=$!

# Wait until the OpenBao API is reachable. Once the server answers on the
# /v1/sys/init endpoint it is up, regardless of whether it is initialized or
# sealed yet.
bashio::log.debug "Waiting for OpenBao to become reachable ..."
for _ in $(seq 1 120); do
    if curl -fsS "${init_endpoint}" >/dev/null 2>&1; then
        break
    fi
    sleep 1
done

# Determine whether OpenBao is already initialized
if curl -fsS "${init_endpoint}" | grep -qi '"initialized":true'; then
    bashio::log.info "OpenBao is already initialized"
else
    bashio::log.info "Initializing OpenBao ..."
    init_output=$(bao operator init -key-shares=1 -key-threshold=1 2>&1)
    init_rc=$?
    if [ "${init_rc}" -ne 0 ]; then
        bashio::log.error "OpenBao initialization failed"
        bashio::log.error "${init_output}"
    else
        # Persist unseal key(s) and root token
        printf '%s\n' "${init_output}" > "${secrets_file}"
        chmod 600 "${secrets_file}"

        root_token=$(printf '%s\n' "${init_output}" | grep -i "Initial Root Token" | awk '{print $NF}')
        if bashio::var.has_value "${root_token}"; then
            bashio::log.info "======================================================"
            bashio::log.info "OpenBao root token: ${root_token}"
            bashio::log.info "Save this token, it is shown only once."
            bashio::log.info "======================================================"
        else
            bashio::log.error "Could not determine the root token from the initialization output"
        fi
    fi
fi

# Unseal OpenBao using the stored unseal key(s)
if [ -f "${secrets_file}" ]; then
    bashio::log.info "Unsealing OpenBao ..."
    #nolint:SC2013
    for key in $(grep -i "Unseal Key" "${secrets_file}" | awk '{print $NF}'); do
        bao operator unseal "${key}" >/dev/null 2>&1
    done
else
    bashio::log.warning "No unseal keys found (${secrets_file}). OpenBao will start sealed."
fi

# Keep the server in the foreground. Instead of relying on "wait" - which can
# return early with a non-zero code and make s6 think the service exited - poll
# until the OpenBao server process is actually gone, then exit with its status.
while kill -0 "${server_pid}" 2>/dev/null; do
    sleep 2
done

wait "${server_pid}"
exit $?
