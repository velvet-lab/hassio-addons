#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash

# Config locations come from the container environment (set by qdrant-pre).
# They are REQUIRED: abort if they are missing instead of falling back to a default.
# shellcheck disable=SC2153  # APP_CONFIG_* are container-env vars set by with-contenv
config_source="${APP_CONFIG_SOURCE:?APP_CONFIG_SOURCE is not set (qdrant-pre did not run)}"
config_dest="${APP_CONFIG_DEST:?APP_CONFIG_DEST is not set (qdrant-pre did not run)}"

# Set Log Level
bashio::log.level "$(bashio::config 'log_level' 'info')"

bashio::log.info "Start Qdrant ..."

# Render every file from the user-edited APP_CONFIG_SOURCE into the volatile
# APP_CONFIG_DEST folder with envsubst. This always runs, even when the bundled
# template has no placeholders, because the user may have added ${VAR}
# references to their configuration file that must be expanded here (with the
# full s6 container environment available).
bashio::log.debug "Render configuration files"
mkdir -p "${config_dest}"
for file in "${config_source}"/*; do
    name=$(basename "${file}")
    envsubst < "${file}" > "${config_dest}/${name}"
    chmod 644 "${config_dest}/${name}"
done

# Run Qdrant from its bundle directory so the (relative) static_content_dir
# resolves to the bundled Web UI in /opt/qdrant/static. The config is passed
# explicitly via --config-path; storage/snapshots paths are absolute. The
# binary is the same release tarball on both architectures at
# /opt/qdrant/qdrant.
cd /opt/qdrant || exit 1

# shellcheck disable=SC2153  # APP_CONFIG_DEST is a container-env var
bashio::log.debug "Qdrant build marker: qdrant-build-v7-config"
exec /opt/qdrant/qdrant --config-path "${config_dest}/production.yaml"
