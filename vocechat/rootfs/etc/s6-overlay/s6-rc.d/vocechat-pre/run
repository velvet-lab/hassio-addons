# Generated by VoceChat Addon

[webclient]
url = "https://sh.voce.chat/web_client/v0.4.x"

[system]
data_dir = "${DATA_ROOT}"
token_expiry_seconds = ${TOKEN_EXPIRY_SECONDS}
refresh_token_expiry_seconds = ${REFRESH_TOKEN_EXPIRY_SECONDS}
magic_token_expiry_seconds = ${MAGIC_TOKEN_EXPIRY_SECONDS}

[network]
bind = "0.0.0.0:3000"
domain = "${DOMAIN}"

[template.register_by_email]
subject = "${TEMPLATE_REGISTER_BY_MAIL}"
file = "${HA_CONFIG_ROOT}/register_by_email.html"

[template.login_by_email]
subject = "${TEMPLATE_LOGIN_BY_MAIL}"
file = "${HA_CONFIG_ROOT}/login_by_email.html"
EOF

