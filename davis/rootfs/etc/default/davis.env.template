# Davis server configuration
#
# This template is copied to /homeassistant/addons/davis/davis.env on first
# start, where you can edit it (e.g. with VS Code). The add-on renders this
# file into the runtime `.env.local` on every start, so a restart is required
# after you change it.
#
# The most important settings are controlled by the add-on options (see the
# Home Assistant UI): admin_login / admin_password, the protocol toggles
# (caldav_enabled / carddav_enabled / webdav_enabled / home_enabled /
# public_calendars_enabled), the mail connection (mail_host / mail_port /
# mail_username / mail_password), use_mysql and log_level. Their `${...}`
# placeholders below are replaced at start time from the UI options, so do NOT
# edit those lines.
#
# Everything else can be fine-tuned here.

# Generic application settings
APP_ENV=prod
APP_TIMEZONE=${APP_TIMEZONE}
LOG_FILE_PATH=/data/davis/logs/app.log
BIRTHDAY_REMINDER_OFFSET=${BIRTHDAY_REMINDER_OFFSET}
CALDAV_ENABLED=${CALDAV_ENABLED}
CARDDAV_ENABLED=${CARDDAV_ENABLED}
WEBDAV_ENABLED=${WEBDAV_ENABLED}
PUBLIC_CALENDARS_ENABLED=${PUBLIC_CALENDARS_ENABLED}

# Database settings
DATABASE_DRIVER=${DATABASE_DRIVER}
DATABASE_URL=${DATABASE_URL}

# Authentication settings for the Davis admin interface
ADMIN_LOGIN=${ADMIN_LOGIN}
ADMIN_PASSWORD=${ADMIN_PASSWORD}
ADMIN_AUTH_BYPASS=false
AUTH_METHOD=Basic
AUTH_REALM=DavisDAV

# WebDAV settings
WEBDAV_TMP_DIR=/tmp
WEBDAV_PUBLIC_DIR=/data/davis/public
WEBDAV_HOMES_DIR=${HOME_DIR}

# Mail settings
INVITE_FROM_ADDRESS=${INVITE_FROM_ADDRESS}
MAIL_HOST=${MAIL_HOST}
MAIL_PORT=${MAIL_PORT}
MAIL_USERNAME=${MAIL_USERNAME}
MAIL_PASSWORD=${MAIL_PASSWORD}

# Trust the immediate proxy for X-Forwarded-* headers including HTTPS detection
SYMFONY_TRUSTED_PROXIES=${TRUSTED_PROXIES}