#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash

# Static, unique build marker. Bump this value on every code change so we can
# verify from the log whether the container image was actually rebuilt and is
# not a stale cache. If the marker is NOT visible in the log, the image is old.
readonly build_marker="gogs-build-v10-config"

root=/data
app_name="gogs"
gogs_root="$root/${app_name}"
data_root="$gogs_root/data"
homeassistant_root="/homeassistant"
config_source="$homeassistant_root/addons/${app_name}"
config_dest="/etc/${app_name}"
user_config="$config_source/gogs.ini"

default_log_level="info"

log_level=$(bashio::config 'log_level' "$default_log_level")
bashio::log.level "${log_level}"

bashio::log.info "Gogs build marker: ${build_marker}"
bashio::log.info "Prepare Gogs configuration"

# Expose the app identity and config locations via the s6 container
# environment (one file per variable). The core service reads them via
# with-contenv to render and load the configuration.
echo -n "${app_name}" > /var/run/s6/container_environment/APP_NAME
echo -n "${config_source}" > /var/run/s6/container_environment/APP_CONFIG_SOURCE
echo -n "${config_dest}" > /var/run/s6/container_environment/APP_CONFIG_DEST

# Ensure the Gogs custom directory layout exists. The "custom" directory
# location is set via GOGS_CUSTOM in the image and holds data/ and log/. Config
# is rendered volatile to APP_CONFIG_DEST (/etc/gogs) by the core service.
bashio::log.debug "Create folders"
for folder in "${config_source}" "${config_dest}" "${data_root}"; do
    if ! bashio::fs.directory_exists "${folder}"; then
        bashio::log.debug "Creating folder ${folder}"
        mkdir -p "${folder}"
        chmod 755 "${folder}"
    fi
done

# Gogs refuses to start while SECRET_KEY uses the default value. The
# `secret_key` setting is a REQUIRED add-on option (Home Assistant stores it
# encrypted). Instead of generating a secret on first start, abort startup if
# the user has not provided one — a generated key would diverge from the value
# in the user's configuration and break sessions/cookies after a restart.
if ! bashio::var.has_value "$(bashio::config 'secret_key')"; then
    bashio::log.error "The 'secret_key' option is required but empty."
    bashio::log.error "Set a strong random value, e.g. generated with:"
    bashio::log.error "    openssl rand -hex 32"
    bashio::log.error "and restart the add-on."
    exit 1
fi

bashio::log.debug "Using the secret_key from the add-on configuration"
# Write it into the s6 container environment (one file per variable) so the
# longrun service picks it up via with-contenv. with-contenv loads these files
# only at script start, so the actual ${...} expansion happens in gogs-core/run
# (not here) where GOGS_SECRET_KEY is already an environment variable.
GOGS_SECRET_KEY="$(bashio::config 'secret_key')"
echo -n "${GOGS_SECRET_KEY}" > /var/run/s6/container_environment/GOGS_SECRET_KEY

# Export data directory paths for template rendering
echo -n "${data_root}" > /var/run/s6/container_environment/GOGS_DATA_PATH
echo -n "${gogs_root}/repositories" > /var/run/s6/container_environment/GOGS_REPO_ROOT

# Optional Redis-backed session + cache store.
#
# Home Assistant only allows `mysql` and `mqtt` as add-on services, so the
# internal valkey add-on cannot be registered as `redis`. We therefore resolve
# the connection from a Redis discovery service advertised by another add-on
# (e.g. the bundled valkey add-on) via the Supervisor Discovery API, and only
# fall back to a Supervisor-registered `redis` service (e.g. a third-party
# Redis add-on) when such a service is genuinely available. The default host is
# the internal hostname of the bundled valkey add-on (`core-valkey`).
redis_enabled=$(bashio::config 'redis_enabled' false)

session_provider="file"
session_config="${data_root}/sessions"
cache_adapter="memory"
cache_host=""

if bashio::var.true "$redis_enabled"; then
    # The redis_host / redis_port options were removed: the connection is
    # resolved from a Redis discovery service. The optional `redis_password`
    # option can still override / supply the password for a Redis server that
    # does not advertise itself.
    redis_host=""
    redis_port=""
    redis_password=$(bashio::config 'redis_password' '')

    # 1. Try the Supervisor Discovery API: look for the first discovery entry
    #    whose service is `redis` and read host / port / password from its
    #    config. Requires hassio_api: true (provides SUPERVISOR_TOKEN).
    # shellcheck disable=SC2154  # SUPERVISOR_TOKEN is injected by the Supervisor
    if bashio::var.has_value "${SUPERVISOR_TOKEN}"; then
        discovery=$(curl -sSL -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
            "http://supervisor/discovery" 2>/dev/null)
        # Only parse with jq when the response actually is a JSON object; a
        # non-JSON / empty reply would otherwise abort the s6 oneshot.
        if [[ "${discovery:0:1}" == "{" ]]; then
            redis_entry=$(echo "${discovery}" | jq -r '((.discovery // [])[] | select(.service == "redis") | .config) // {}' 2>/dev/null)
            if bashio::var.has_value "${redis_entry}" && [[ "${redis_entry:0:1}" == "{" ]]; then
                candidate_host=$(echo "${redis_entry}" | jq -r '.host // ""')
                candidate_port=$(echo "${redis_entry}" | jq -r '.port // ""')
                candidate_password=$(echo "${redis_entry}" | jq -r '.password // ""')
                if bashio::var.has_value "${candidate_host}"; then
                    redis_host="${candidate_host}"
                    redis_port="${candidate_port}"
                    if ! bashio::var.has_value "${redis_password}"; then
                        redis_password="${candidate_password}"
                    fi
                    bashio::log.info "Resolved Redis connection from Discovery (${redis_host}:${redis_port})"
                fi
            fi
        fi
    fi

    if ! bashio::var.has_value "${redis_host}"; then
        # No discovery service found: fall back to a Supervisor-registered
        # redis service if present.
        if bashio::services.available "redis"; then
            redis_host=$(bashio::services "redis" "host")
            redis_port=$(bashio::services "redis" "port")
            if ! bashio::var.has_value "${redis_password}"; then
                redis_password=$(bashio::services "redis" "password")
            fi
        fi
    fi

    # The internal add-on hostname is NOT a fixed `core-<slug>` name; it is
    # hash-prefixed (e.g. `b65924cf-valkey`), so we must never fall back to a
    # hard-coded host. Instead, require a resolved host and abort otherwise.
    if ! bashio::var.has_value "${redis_host}"; then
        bashio::log.error "No Redis host could be resolved."
        bashio::log.error "A 'redis' discovery service must be available (is the Valkey add-on installed, running, and registered?)."
        bashio::log.error "Ensure the Valkey add-on is started and this add-on has been restarted with hassio_api enabled."
        exit 1
    fi
    if ! bashio::var.has_value "${redis_port}"; then
        redis_port=6379
    fi

    if ! bashio::var.has_value "${redis_password}"; then
        bashio::log.error "No Redis password could be resolved."
        bashio::log.error "Expected a 'redis' discovery service (providing the password) or the 'redis_password' option."
        bashio::log.error "Set the 'redis_password' option to the password used by your Valkey/Redis server and restart the add-on."
        exit 1
    fi

    # A shared connection string used by the [session] PROVIDER_CONFIG and the
    # [cache] HOST settings. password / db=0 are read-only here; users can tune
    # the rest in the editable gogs.ini.
    redis_url="network=tcp,addr=${redis_host}:${redis_port},password=${redis_password},db=0,pool_size=100,idle_timeout=180"

    session_provider="redis"
    session_config="${redis_url}"
    cache_adapter="redis"
    cache_host="${redis_url}"

    bashio::log.info "Gogs will use a Redis server for sessions and cache (${redis_host}:${redis_port})"
else
    bashio::log.debug "Redis is disabled; using file-based sessions and in-memory cache"
fi

echo -n "${session_provider}" > /var/run/s6/container_environment/GOGS_SESSION_PROVIDER
echo -n "${session_config}" > /var/run/s6/container_environment/GOGS_SESSION_CONFIG
echo -n "${cache_adapter}" > /var/run/s6/container_environment/GOGS_CACHE_ADAPTER
echo -n "${cache_host}" > /var/run/s6/container_environment/GOGS_CACHE_HOST

# On first start copy the default configuration to the user-accessible folder
# under /homeassistant, where the user can edit it (e.g. with VS Code). If the
# user deletes the file it is recreated from the bundled template.
if ! bashio::fs.file_exists "${user_config}"; then
    bashio::log.info "Creating default Gogs configuration for the user"
    cp /etc/default/gogs.ini.template "${user_config}"
    chmod 644 "${user_config}"
fi

bashio::log.debug "Redirect log output"
rm -f "${root}/app.err"
ln -s /proc/1/fd/1 "${root}/app.err"

# s6 oneshot services MUST end with exit 0, otherwise s6 treats them as
# "unable to start service ... command exited N" and aborts the whole container
# bring-up (rc.init: fatal: stopping the container).
exit 0