#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash

# Config locations come from the container environment (set by searxng-pre).
# They are REQUIRED: abort if they are missing instead of falling back to a default.
# shellcheck disable=SC2153  # APP_CONFIG_* are container-env vars set by with-contenv
config_source="${APP_CONFIG_SOURCE:?APP_CONFIG_SOURCE is not set (searxng-pre did not run)}"
config_dest="${APP_CONFIG_DEST:?APP_CONFIG_DEST is not set (searxng-pre did not run)}"

# Set Log Level
bashio::log.level "$(bashio::config 'log_level' 'info')"

bashio::log.info "Start SearXNG (Granian) ..."

# Render every file from the user-edited APP_CONFIG_SOURCE (settings.yml,
# limiter.toml, ...) into the volatile APP_CONFIG_DEST folder with envsubst.
# This always runs, even when the bundled template has no placeholders, because
# the user may have added ${VAR} references that must be expanded here (with
# the full s6 container environment available).
bashio::log.debug "Render configuration files"
mkdir -p "${config_dest}"
for file in "${config_source}"/*; do
    name=$(basename "${file}")
    envsubst < "${file}" > "${config_dest}/${name}"
    chmod 644 "${config_dest}/${name}"
done

# Granian serves the WSGI application. SEARXNG_SETTINGS_PATH points to the
# rendered settings.yml in APP_CONFIG_DEST (set by searxng-pre via the
# container environment). The bind host and port are passed explicitly:
# Granian does NOT read server.bind_address/server.port from settings.yml and
# would otherwise fall back to its built-in default 127.0.0.1:8000 (which is
# not reachable from the home network). The add-on always listens on its own
# internal default port 8888 on all interfaces; the port shown in the Home
# Assistant UI is only the exposed port.
#
# The --interface wsgi flag is REQUIRED: SearXNG's flaskfix.py expects a real
# WSGI environ (dict with .get). Granian's default RSGI mode passes an
# RSGIHTTPScope object instead, which has no .get -> "Application callable
# raised an exception: 'RSGIHTTPScope' object has no attribute 'get'".
cd /opt/searxng || exit 1
exec /opt/searxng/venv/bin/granian --interface wsgi --host 0.0.0.0 --port 8888 searx.webapp:app
