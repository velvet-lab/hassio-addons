# New API server configuration
# This template is copied to /homeassistant/addons/newapi/newapi.env on first
# start, where you can edit it. On every start it is rendered to
# /data/newapi/.env (with envsubst) and loaded by New API. Restart the add-on
# after editing.
#
# This is a standard dotenv (KEY=VALUE) file. See the official documentation
# for the full list of variables:
# https://www.newapi.ai/en/docs/installation/config-maintenance/environment-variables
#
# The SESSION_SECRET is generated automatically and persisted on the first
# start; it is injected as an environment variable, so you normally do not
# need to set it here.

# Port New API listens on. This is the *internal* port; the port shown in the
# Home Assistant UI is only the exposed port and stays 3000.
PORT=3000

# Timezone used for log timestamps.
TZ=Etc/UTC

# SQLite database file. The default installation stores everything in a single
# SQLite database file under /data/newapi. Leave SQL_DSN empty to keep SQLite;
# set SQL_DSN below to use an external database instead.
SQLITE_PATH=${NEWAPI_SQLITE_PATH}

# External database connection string. Leave empty to use the bundled SQLite
# database; set it to use an external database (PostgreSQL or MySQL). This is
# rendered from the add-on options:
#   - when the `use_mysql` option is enabled, this is filled with the MySQL DSN
#     of the MariaDB add-on (user:pass@tcp(host:port)/new-api)
#   - otherwise it stays empty and New API falls back to SQLite
# You can also add your own value here to use PostgreSQL or an external MySQL.
SQL_DSN=${NEWAPI_SQL_DSN}

# Optional: Redis-compatible cache for rate limiting and sessions (improves
# performance for multi-user deployments and shared rate limits). Leave empty
# to disable Redis. This is rendered from the add-on options:
#   redis://username:password@host:port/db
# You can also add your own value here.
REDIS_CONN_STRING=${NEWAPI_REDIS_CONN_STRING}