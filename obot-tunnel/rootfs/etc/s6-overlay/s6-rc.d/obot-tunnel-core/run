#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash

# Config locations come from the container environment (set by obot-tunnel-pre).
# They are REQUIRED: abort if they are missing instead of falling back to a default.
# shellcheck disable=SC2153  # APP_CONFIG_* are container-env vars set by with-contenv
config_source="${APP_CONFIG_SOURCE:?APP_CONFIG_SOURCE is not set (obot-tunnel-pre did not run)}"
config_dest="${APP_CONFIG_DEST:?APP_CONFIG_DEST is not set (obot-tunnel-pre did not run)}"

# Set Log Level
bashio::log.level "$(bashio::config 'log_level' 'info')"

# Render every file from the user-edited APP_CONFIG_SOURCE into the volatile
# APP_CONFIG_DEST folder with envsubst. This always runs, even when the bundled
# template has no placeholders, because the user may have added ${VAR}
# references to their configuration file that must be expanded here (with the
# full s6 container environment available).
bashio::log.debug "Render configuration files"
mkdir -p "${config_dest}"
for file in "${config_source}"/*; do
    name=$(basename "${file}")
    envsubst < "${file}" > "${config_dest}/${name}"
    chmod 644 "${config_dest}/${name}"
done

bashio::log.info "Start Obot Tunnel ..."
# s6 longrun services MUST end with exec so s6 owns and terminates the process.
# The tunnel command retries failed connection attempts and lost connections
# indefinitely (exponential backoff 1s..30s), so it keeps running until s6
# stops it.
# shellcheck disable=SC2153  # OBOT_* are container-env vars set by with-contenv
exec /usr/local/bin/obot tunnel \
    --obot-base-url "${OBOT_BASE_URL:?OBOT_BASE_URL is not set (obot-tunnel-pre did not run)}" \
    --token "${OBOT_TUNNEL_TOKEN:?OBOT_TUNNEL_TOKEN is not set (obot-tunnel-pre did not run)}"