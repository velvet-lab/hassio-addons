#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash

# Static, unique build marker. Bump this value on every code change so we can
# verify from the log whether the container image was actually rebuilt and is
# not a stale cache. If the marker is NOT visible in the log, the image is old.
readonly build_marker="openbao-build-v6-config"

root=/data
config_root="$root/openbao/config"
storage_root="$root/openbao/file"
secrets_file="$root/openbao/unseal.keys"
homeassistant_root="/homeassistant"
user_config_root="$homeassistant_root/addons/openbao"
user_config="$user_config_root/openbao.hcl"
init_endpoint="http://127.0.0.1:8200/v1/sys/init"

export BAO_ADDR="http://127.0.0.1:8200"

default_log_level="info"

log_level=$(bashio::config 'log_level' "$default_log_level")
bashio::log.level "${log_level}"

bashio::log.info "OpenBao build marker: ${build_marker}"
bashio::log.info "Prepare OpenBao configuration"

# Map the add-on log level to the OpenBao server log level so the value set in
# the Home Assistant UI also applies to the OpenBao server. Written into the
# s6 container environment so every server instance (temp + core) inherits it.
case "${log_level}" in
    trace|debug|info)
        bao_log_level="${log_level}"
        ;;
    notice|warning)
        bao_log_level="warn"
        ;;
    error|fatal)
        bao_log_level="err"
        ;;
    *)
        bao_log_level="info"
        ;;
esac
bashio::log.debug "Mapping add-on log level '${log_level}' to OpenBao '${bao_log_level}'"
# Export so the envsubst below in this same pre script can substitute it.
export BAO_LOG_LEVEL="${bao_log_level}"
# Write to the s6 container environment so the temp/core server sees it too.
echo -n "${bao_log_level}" > /var/run/s6/container_environment/BAO_LOG_LEVEL

# The Web UI toggle comes from the add-on options (defaults to true).
bashio::log.debug "Read the ui_enable option"
bao_ui_enabled=$(bashio::config 'ui_enable' true)
# Export the value so the pre envsubst below can substitute it.
export BAO_UI_ENABLED="${bao_ui_enabled}"
# Also write it to the s6 container environment for the server instances.
echo -n "${bao_ui_enabled}" > /var/run/s6/container_environment/BAO_UI_ENABLED

bashio::log.debug "Create folders"
if ! bashio::fs.directory_exists "${config_root}"; then
    bashio::log.debug "Creating config root directory at ${config_root}"
    mkdir -p "${config_root}"
    chmod 755 "${config_root}"
fi

if ! bashio::fs.directory_exists "${storage_root}"; then
    bashio::log.debug "Creating storage root directory at ${storage_root}"
    mkdir -p "${storage_root}"
    chmod 755 "${storage_root}"
fi

if ! bashio::fs.directory_exists "${user_config_root}"; then
    bashio::log.debug "Creating user config root directory at ${user_config_root}"
    mkdir -p "${user_config_root}"
    chmod 755 "${user_config_root}"
fi

# On first start copy the default configuration to the user-accessible folder
# under /homeassistant, where the user can edit it (e.g. with VS Code). If the
# user deletes the file it is recreated from the bundled template.
if ! bashio::fs.file_exists "${user_config}"; then
    bashio::log.info "Creating default OpenBao configuration for the user"
    cp /etc/default/openbao.template "${user_config}"
    chmod 644 "${user_config}"
fi

# Render the final configuration for the server by substituting any remaining
# placeholders from the user-edited file into the internal config folder.
bashio::log.debug "Write OpenBao configuration"
envsubst < "${user_config}" > "${config_root}/openbao.hcl"
chmod 644 "${config_root}/openbao.hcl"

# Initialize OpenBao on first start. The unseal keys file is the marker for a
# finished initialization. Initialization requires a running server, so spin
# up a temporary instance, initialize, persist the keys, then stop it again.
if bashio::fs.file_exists "${secrets_file}"; then
    bashio::log.info "OpenBao is already initialized"
else
    bashio::log.info "Initializing OpenBao ..."
    bao server -config="${config_root}" &
    server_pid=$!

    bashio::log.debug "Waiting for the temporary server to become reachable ..."
    for _ in $(seq 1 120); do
        if curl -fsS "${init_endpoint}" >/dev/null 2>&1; then
            break
        fi
        sleep 1
    done

    if curl -fsS "${init_endpoint}" | grep -qi '"initialized":true'; then
        bashio::log.info "OpenBao is already initialized"
    else
        init_output=$(bao operator init -key-shares=1 -key-threshold=1 2>&1)
        init_rc=$?
        if [ "${init_rc}" -ne 0 ]; then
            bashio::log.error "OpenBao initialization failed"
            bashio::log.error "${init_output}"
        else
            # Persist unseal key(s) and root token
            printf '%s\n' "${init_output}" > "${secrets_file}"
            chmod 600 "${secrets_file}"

            root_token=$(printf '%s\n' "${init_output}" | grep -i "Initial Root Token" | awk '{print $NF}')
            if bashio::var.has_value "${root_token}"; then
                bashio::log.info "======================================================"
                bashio::log.info "OpenBao root token: ${root_token}"
                bashio::log.info "Save this token, it is shown only once."
                bashio::log.info "======================================================"
            else
                bashio::log.error "Could not determine the root token from the initialization output"
            fi
        fi
    fi

    # Stop the temporary server again; s6 is not managing this instance
    kill "${server_pid}" 2>/dev/null || true
    wait "${server_pid}" 2>/dev/null || true
fi

bashio::log.debug "Redirect log output"
rm -f "${root}/app.err"
ln -s /proc/1/fd/1 "${root}/app.err"
