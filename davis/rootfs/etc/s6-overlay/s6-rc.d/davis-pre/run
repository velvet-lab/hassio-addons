#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash

# Static, unique build marker. Bump this value on every code change so we can
# verify from the log whether the container image was actually rebuilt and is
# not a stale cache. If the marker is NOT visible in the log, the image is old.
readonly build_marker="davis-build-v9-config"

root=/data
app_name="davis"
data_root="$root/${app_name}"
log_root="$data_root/logs"
public_root="$data_root/public"
home_root="$data_root/homes"
database_driver="sqlite"
database_url="sqlite:////data/${app_name}/davis.db"

homeassistant_root="/homeassistant"
config_source="$homeassistant_root/addons/${app_name}"
config_dest="/etc/${app_name}"
user_config="$config_source/davis.env"

default_log_level="info"

# Set Log Level
log_level=$(bashio::config 'log_level' "$default_log_level")
bashio::log.level "$log_level"

bashio::log.info "Davis build marker: ${build_marker}"
bashio::log.info "Starting davis pre-initialization script..."

# Expose the app identity and config locations via the s6 container
# environment (one file per variable). The core service reads them via
# with-contenv.
echo -n "${app_name}" > /var/run/s6/container_environment/APP_NAME
echo -n "${config_source}" > /var/run/s6/container_environment/APP_CONFIG_SOURCE
echo -n "${config_dest}" > /var/run/s6/container_environment/APP_CONFIG_DEST

bashio::log.debug "Ensuring directories exists..."
bashio::log.debug "Ensuring log directory exists..."
if ! bashio::fs.directory_exists "$log_root"; then
    mkdir -p "$log_root"
fi

bashio::log.debug "Ensuring public and homes directories exist..."
if ! bashio::fs.directory_exists "$public_root"; then
    mkdir -p "$public_root"
fi

bashio::log.debug "Ensuring config and user config directories exist..."
for d in "$config_source" "$config_dest"; do
    if ! bashio::fs.directory_exists "$d"; then
        mkdir -p "$d"
        chmod 755 "$d"
    fi
done

# On first start copy the default configuration to the user-accessible folder
# (APP_CONFIG_SOURCE) under /homeassistant, where the user can edit it (e.g.
# with VS Code). If the user deletes the file it is recreated from the bundled
# template.
if ! bashio::fs.file_exists "$user_config"; then
    bashio::log.info "Creating default Davis configuration for the user"
    cp /etc/default/davis.env.template "$user_config"
    chmod 644 "$user_config"
fi

bashio::log.debug "Reading configuration options (UI options only)..."
# Auto-detect application timezone; prefer /etc/timezone, then /etc/localtime symlink.
if [ -f /etc/timezone ]; then
    app_timezone=$(cat /etc/timezone)
elif [ -L /etc/localtime ]; then
    app_timezone=$(readlink /etc/localtime | sed 's|.*/zoneinfo/||')
else
    app_timezone="UTC"
fi

# These settings are intentionally not UI-configurable; use sensible defaults
# or the editable `davis.env` template under /homeassistant/addons/davis.
birthday_reminder_offset=''
invite_from_address=''
trusted_proxies='REMOTE_ADDR'

caldav_enabled=$(bashio::config 'caldav_enabled' false)
carddav_enabled=$(bashio::config 'carddav_enabled' false)
webdav_enabled=$(bashio::config 'webdav_enabled' false)
home_enabled=$(bashio::config 'home_enabled' false)
public_calendars_enabled=$(bashio::config 'public_calendars_enabled' false)
admin_login=$(bashio::config 'admin_login')
admin_password=$(bashio::config 'admin_password')
mail_host=$(bashio::config 'mail_host' '')
mail_port=$(bashio::config 'mail_port' '')
mail_username=$(bashio::config 'mail_username' '')
mail_password=$(bashio::config 'mail_password' '')
use_mysql=$(bashio::config 'use_mysql' false)

bashio::log.debug "Validate options..."
bashio::config.require 'admin_login' "Admin login must be set!"

# The `admin_password` option is REQUIRED but not optional. Abort startup if
# the user has not provided one instead of initializing with an empty/default
# value.
if ! bashio::var.has_value "${admin_password}"; then
    bashio::log.error "The 'admin_password' option is required but empty."
    bashio::log.error "Set a strong admin password and restart the add-on."
    exit 1
fi

if bashio::var.true "$home_enabled" && ! bashio::fs.directory_exists "$home_root"; then
    mkdir -p "$home_root"
    home_root=
fi

if bashio::var.true "$use_mysql"; then
    database_driver="mysql"

    db_host=$(bashio::services "mysql" "host")
    db_host_ipv4=$(dig +short A "$db_host")
    db_port=$(bashio::services "mysql" "port")
    db_password=$(bashio::services "mysql" "password")
    db_user=$(bashio::services "mysql" "username")

    database_url="mysql://$db_user:$db_password@$db_host_ipv4:$db_port/davis?charset=utf8mb4"

    bashio::log.debug "Creating database if not exists..."
    bashio::log.debug "Connecting to MariaDB at ${db_host_ipv4}:${db_port} with user ${db_user}"
    bashio::log.debug "Database URL: mysql://$db_user:**********@$db_host_ipv4:$db_port/davis?charset=utf8mb4"
    mariadb -u "${db_user}" -p"${db_password}" -h "${db_host_ipv4}" -P "${db_port}" --skip-ssl -e "CREATE DATABASE IF NOT EXISTS \`davis\` ;"

    bashio::log.warning "Davis is using the Maria DB addon"
    bashio::log.warning "Please ensure this is included in your backups"
    bashio::log.warning "Uninstalling the MariaDB addon will remove any data"
fi

bashio::log.debug "Exporting environment variables for the services..."
# Write each resolved value into the s6 container environment (one file per
# variable) so the davis-migration service and the longrun services
# (php-fpm, davis-core) inherit them via with-contenv.
echo -n "$app_timezone" > /var/run/s6/container_environment/APP_TIMEZONE
echo -n "$birthday_reminder_offset" > /var/run/s6/container_environment/BIRTHDAY_REMINDER_OFFSET
echo -n "$caldav_enabled" > /var/run/s6/container_environment/CALDAV_ENABLED
echo -n "$carddav_enabled" > /var/run/s6/container_environment/CARDDAV_ENABLED
echo -n "$webdav_enabled" > /var/run/s6/container_environment/WEBDAV_ENABLED
echo -n "$public_calendars_enabled" > /var/run/s6/container_environment/PUBLIC_CALENDARS_ENABLED
echo -n "$invite_from_address" > /var/run/s6/container_environment/INVITE_FROM_ADDRESS
echo -n "$mail_host" > /var/run/s6/container_environment/MAIL_HOST
echo -n "$mail_port" > /var/run/s6/container_environment/MAIL_PORT
echo -n "$mail_username" > /var/run/s6/container_environment/MAIL_USERNAME
echo -n "$mail_password" > /var/run/s6/container_environment/MAIL_PASSWORD
echo -n "$admin_login" > /var/run/s6/container_environment/ADMIN_LOGIN
echo -n "$admin_password" > /var/run/s6/container_environment/ADMIN_PASSWORD
echo -n "$home_root" > /var/run/s6/container_environment/HOME_DIR
echo -n "$database_driver" > /var/run/s6/container_environment/DATABASE_DRIVER
echo -n "$database_url" > /var/run/s6/container_environment/DATABASE_URL
echo -n "$trusted_proxies" > /var/run/s6/container_environment/TRUSTED_PROXIES
echo -n "$data_root" > /var/run/s6/container_environment/DAVIS_DATA_DIR
echo -n "$log_root/app.log" > /var/run/s6/container_environment/DAVIS_LOG_FILE_PATH
echo -n "$public_root" > /var/run/s6/container_environment/DAVIS_PUBLIC_DIR

bashio::log.debug "Setting permissions on data directory..."
chmod -R 755 "$data_root"
chown -R www-data:www-data "$data_root"

bashio::log.debug "Redirect log output"
rm -f "${root}/app.err"
ln -s /proc/1/fd/1 "${root}/app.err"

bashio::log.debug "Configure Nginx to log to stdout"
sed -i 's|error_log /var/log/nginx/error\.log;|error_log /proc/1/fd/1 error;|' /etc/nginx/nginx.conf

# s6 oneshot services MUST end with exit 0, otherwise s6 treats them as
# "unable to start service ... command exited N" and aborts the whole
# container bring-up (rc.init: fatal: stopping the container).
exit 0
