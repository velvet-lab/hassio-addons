#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash

# Config locations come from the container environment (set by gogs-pre). They
# are REQUIRED: abort if they are missing instead of falling back to a default.
# shellcheck disable=SC2153  # APP_CONFIG_* / GOGS_CUSTOM are container-env vars set by with-contenv
config_source="${APP_CONFIG_SOURCE:?APP_CONFIG_SOURCE is not set (gogs-pre did not run)}"
config_dest="${GOGS_CUSTOM:?GOGS_CUSTOM is not set (gogs-pre did not run)}"

bashio::log.level "$(bashio::config 'log_level' 'info')"

# The admin credentials are REQUIRED add-on options. Home Assistant stores the
# password encrypted; there is no sensible default, so we abort startup if the
# user has not provided them instead of guessing.
admin_user=$(bashio::config 'admin_user')
admin_email=$(bashio::config 'admin_email')
admin_password=$(bashio::config 'admin_password')

if ! bashio::var.has_value "${admin_user}"; then
    bashio::log.error "The 'admin_user' option is required but empty."
    bashio::log.error "Set a value and restart the add-on."
    exit 1
fi
if ! bashio::var.has_value "${admin_email}"; then
    bashio::log.error "The 'admin_email' option is required but empty."
    bashio::log.error "Set a value and restart the add-on."
    exit 1
fi
if ! bashio::var.has_value "${admin_password}"; then
    bashio::log.error "The 'admin_password' option is required but empty."
    bashio::log.error "Set a strong random value, e.g. generated with:"
    bashio::log.error "    openssl rand -base64 24"
    bashio::log.error "and restart the add-on."
    exit 1
fi

# Render the configuration so the CLI connects to the right database. Gogs
# loads it from GOGS_CUSTOM/conf/app.ini (set by gogs-pre / the Dockerfile).
bashio::log.debug "Render Gogs configuration"
mkdir -p "${config_dest}/conf"
envsubst < "${config_source}/app.ini" > "${config_dest}/conf/app.ini"
chmod 644 "${config_dest}/conf/app.ini"

# The admin account is created exactly once, on the very first start. A flag
# file marks that this happened so we do not spin up a temporary server on
# every restart.
admin_flag="/data/gogs/admin-created"
if [ -f "${admin_flag}" ]; then
    bashio::log.debug "Admin already created (${admin_flag} exists); skipping"
    exit 0
fi

# Gogs can only create the admin once its database is initialized, and the
# schema migrations only run when the Gogs web server starts (gogs web) — not
# when the admin CLI is invoked against an empty DB. So we start a temporary
# server here, wait until it is reachable (which runs the migrations), create
# the admin, write the flag and shut the temporary server down again. The real
# longrun (gogs-core) then starts normally afterwards.
bashio::log.info "Starting a temporary Gogs server to initialize the database and create the admin ..."
gogs web >/dev/null 2>&1 &
gogs_pid=$!

# Wait until the Gogs HTTP API is reachable. This is a oneshot that runs before
# gogs-core, so the temp server must come up on its own; a retry loop guards
# against a slow first start.
bashio::log.debug "gogs-admin: waiting for Gogs on http://127.0.0.1:3000"
ready=0
for _ in $(seq 1 60); do
    if curl -fsS "http://127.0.0.1:3000/" >/dev/null 2>&1; then
        ready=1
        break
    fi
    if ! kill -0 "${gogs_pid}" 2>/dev/null; then
        bashio::log.error "The temporary Gogs server exited before becoming ready."
        break
    fi
    sleep 1
done

if [ "${ready}" -ne 1 ]; then
    bashio::log.error "Gogs did not become ready; cannot create the admin user."
    kill "${gogs_pid}" 2>/dev/null || true
    wait "${gogs_pid}" 2>/dev/null || true
    exit 1
fi

# Create the first admin account. There is no "list-users" subcommand, so we
# simply attempt creation; on a later/fresh state where it already exists the
# CLI fails, which we treat as non-fatal (the flag below then prevents a
# repeated spin-up on every start).
bashio::log.info "Creating admin user '${admin_user}' ..."
if gogs admin create-user \
    --config "${config_dest}/conf/app.ini" \
    --name "${admin_user}" \
    --password "${admin_password}" \
    --email "${admin_email}" \
    --admin; then
    bashio::log.info "Admin user '${admin_user}' created."
else
    bashio::log.warning "Could not create admin user '${admin_user}' (it may already exist); continuing."
fi

# Mark the admin as handled so future starts skip the temporary server. Written
# regardless of the outcome to guarantee idempotence (the user already exists on
# subsequent starts anyway).
echo "created" > "${admin_flag}"
chmod 600 "${admin_flag}"

# Shut the temporary server down; gogs-core takes over from here.
bashio::log.debug "Stopping temporary Gogs server (pid ${gogs_pid})"
kill "${gogs_pid}" 2>/dev/null || true
wait "${gogs_pid}" 2>/dev/null || true

# s6 oneshot services MUST end with exit 0, otherwise s6 treats them as
# "unable to start service ... command exited N" and aborts the whole container
# bring-up (rc.init: fatal: stopping the container).
exit 0
