#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
root=/data
config_root="$root/qdrant/config"
storage_root="$root/qdrant/storage"
snapshots_root="$root/qdrant/snapshots"
config_file="${config_root}/production.yaml"
homeassistant_root="/homeassistant"
user_config_root="$homeassistant_root/addons/qdrant"
user_config="$user_config_root/production.yaml"

default_log_level="info"

log_level=$(bashio::config 'log_level' "$default_log_level")
bashio::log.level "${log_level}"

bashio::log.info "Prepare Qdrant configuration"

bashio::log.debug "Create folders"
if ! bashio::fs.directory_exists "${config_root}"; then
    bashio::log.debug "Creating config root directory at ${config_root}"
    mkdir -p "${config_root}"
    chmod 755 "${config_root}"
fi

if ! bashio::fs.directory_exists "${storage_root}"; then
    bashio::log.debug "Creating storage root directory at ${storage_root}"
    mkdir -p "${storage_root}"
    chmod 755 "${storage_root}"
fi

if ! bashio::fs.directory_exists "${snapshots_root}"; then
    bashio::log.debug "Creating snapshots root directory at ${snapshots_root}"
    mkdir -p "${snapshots_root}"
    chmod 755 "${snapshots_root}"
fi

if ! bashio::fs.directory_exists "${user_config_root}"; then
    bashio::log.debug "Creating user config root directory at ${user_config_root}"
    mkdir -p "${user_config_root}"
    chmod 755 "${user_config_root}"
fi

# On first start copy the default configuration to the user-accessible folder
# under /homeassistant, where the user can edit it (e.g. with VS Code). If the
# user deletes the file it is recreated from the bundled template.
if ! bashio::fs.file_exists "${user_config}"; then
    bashio::log.info "Creating default Qdrant configuration for the user"
    cp /etc/default/production.template "${user_config}"
    chmod 644 "${user_config}"
fi

# Render the final configuration for the server from the user-edited file. The
# ports are read from the add-on configuration so they match the ports shown
# in the Home Assistant UI.
bashio::log.debug "Write Qdrant configuration"
export QDRANT_HTTP_PORT QDRANT_GRPC_PORT
QDRANT_HTTP_PORT="$(bashio::addon.port '6333/tcp')"
QDRANT_GRPC_PORT="$(bashio::addon.port '6334/tcp')"
envsubst < "${user_config}" > "${config_file}"
chmod 644 "${config_file}"

# The Qdrant binary resolves its configuration file relative to its working
# directory, so we must run it from the folder that contains the config.
echo -n "${config_root}" > /var/run/s6/container_environment/QDRANT_CONFIG_DIR

# Protect the Qdrant HTTP/gRPC APIs (and thus the Web UI) with an admin
# password. Qdrant picks up the value from the QDRANT__SERVICE__API_KEY
# environment variable (double-underscore based env config mapping).
admin_password=$(bashio::config 'admin_password')
if bashio::var.has_value "${admin_password}"; then
    bashio::log.debug "Enabling Qdrant admin password"
    echo -n "${admin_password}" > /var/run/s6/container_environment/QDRANT__SERVICE__API_KEY
fi

bashio::log.debug "Redirect log output"
rm -f "${root}/app.err"
ln -s /proc/1/fd/1 "${root}/app.err"
