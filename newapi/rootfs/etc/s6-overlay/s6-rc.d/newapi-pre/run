#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash

# Static, unique build marker. Bump this value on every code change so we can
# verify from the log whether the container image was actually rebuilt and is
# not a stale cache. If the marker is NOT visible in the log, the image is old.
readonly build_marker="newapi-build-v4-config"

root=/data
app_name="newapi"
data_root="$root/${app_name}"
homeassistant_root="/homeassistant"
config_source="$homeassistant_root/addons/${app_name}"
config_dest="/etc/${app_name}"
user_config="$config_source/newapi.env"

default_log_level="info"

log_level=$(bashio::config 'log_level' "$default_log_level")
bashio::log.level "${log_level}"

bashio::log.info "New API build marker: ${build_marker}"
bashio::log.info "Prepare New API configuration"

# Expose the app identity and config locations via the s6 container
# environment (one file per variable). The core service reads them via
# with-contenv to render and load the configuration.
echo -n "${app_name}" > /var/run/s6/container_environment/APP_NAME
echo -n "${config_source}" > /var/run/s6/container_environment/APP_CONFIG_SOURCE
echo -n "${config_dest}" > /var/run/s6/container_environment/APP_CONFIG_DEST

bashio::log.debug "Create folders"
for folder in "${data_root}" "${config_source}" "${config_dest}"; do
    if ! bashio::fs.directory_exists "${folder}"; then
        bashio::log.debug "Creating folder ${folder}"
        mkdir -p "${folder}"
        chmod 755 "${folder}"
    fi
done

# New API refuses to start when SESSION_SECRET is the literal string
# "random_string" and generates a fresh random value on every start when it is
# unset. The `session_secret` setting is a REQUIRED add-on option (Home
# Assistant stores it encrypted). Instead of generating a secret on first start,
# abort startup if the user has not provided one — a generated key would diverge
# from the value in the user's configuration and break sessions after a restart.
if ! bashio::var.has_value "$(bashio::config 'session_secret')"; then
    bashio::log.error "The 'session_secret' option is required but empty."
    bashio::log.error "Set a strong random value, e.g. generated with:"
    bashio::log.error "    openssl rand -hex 32"
    bashio::log.error "and restart the add-on."
    exit 1
fi

bashio::log.debug "Using the session_secret from the add-on configuration"
session_secret="$(bashio::config 'session_secret')"

# Export the secret via the s6 container environment so the longrun service
# can inherit it regardless of the .env file.
echo -n "${session_secret}" > /var/run/s6/container_environment/SESSION_SECRET
unset session_secret

# On first start copy the default configuration template to the user-accessible
# folder under /homeassistant, where the user can edit it (e.g. with VS Code).
# If the user deletes the file it is recreated from the bundled template.
if ! bashio::fs.file_exists "${user_config}"; then
    bashio::log.info "Creating default New API configuration for the user"
    cp /etc/default/newapi.template "${user_config}"
    chmod 644 "${user_config}"
fi

bashio::log.debug "Redirect log output"
rm -f "${root}/app.err"
ln -s /proc/1/fd/1 "${root}/app.err"

# s6 oneshot services MUST end with exit 0, otherwise s6 treats them as
# "unable to start service ... command exited N" and aborts the whole container
# bring-up (rc.init: fatal: stopping the container).
exit 0