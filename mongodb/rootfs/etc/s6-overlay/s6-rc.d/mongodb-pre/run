#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash

app_name="mongodb"
root="/data"
homeassistant_root="/homeassistant"
run_root="/run/${app_name}"
data_root="${root}/${app_name}"
config_source="${homeassistant_root}/addons/${app_name}"
config_dest="/etc/${app_name}"
mongodb_config="${config_dest}/mongod.conf"
default_config="/etc/default/mongod.conf"
key_file="${root}/keyfile"
build_marker="mongodb-build-v2-s6-config"

log_level=$(bashio::config 'log_level' 'warning')
bashio::log.level "${log_level}"

bashio::log.info "Prepare MongoDB configuration"
bashio::log.info "Build marker: ${build_marker}"

if ! bashio::var.has_value "$(bashio::config 'admin_password')"; then
    bashio::log.error "The 'admin_password' option is required but empty."
    bashio::log.error "Set a strong value and restart the add-on."
    exit 1
fi

bashio::log.debug "Create folders"
mkdir -p "${run_root}" "${data_root}" "${config_source}" "${config_dest}"
chmod 755 "${run_root}" "${data_root}" "${config_source}" "${config_dest}"

if ! bashio::fs.file_exists "${key_file}"; then
    bashio::log.info "Create keyfile for security"
    openssl rand -base64 756 | tr -d '\n\r' > "${key_file}"
    chmod 400 "${key_file}"
fi

if ! bashio::fs.file_exists "${config_source}/mongod.conf"; then
    bashio::log.info "No existing configuration found, creating default configuration"
    cp "${default_config}" "${config_source}/mongod.conf"
    chmod 644 "${config_source}/mongod.conf"
fi

bashio::log.debug "Redirect log output"
rm -f "${root}/app.err"
ln -s /proc/1/fd/1 "${root}/app.err"

bashio::log.debug "Export environment variables"
echo -n "${app_name}" > /var/run/s6/container_environment/APP_NAME
echo -n "${config_source}" > /var/run/s6/container_environment/APP_CONFIG_SOURCE
echo -n "${config_dest}" > /var/run/s6/container_environment/APP_CONFIG_DEST
echo -n "${data_root}" > /var/run/s6/container_environment/DATA_ROOT
echo -n "${mongodb_config}" > /var/run/s6/container_environment/MONGODB_CONFIG
echo -n "admin" > /var/run/s6/container_environment/MONGODB_ADMIN_USER
printf '%s' "$(bashio::config 'admin_password')" > /var/run/s6/container_environment/MONGODB_ADMIN_PASSWORD

exit 0
