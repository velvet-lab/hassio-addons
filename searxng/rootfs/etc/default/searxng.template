# SearXNG configuration
# Learn more: https://docs.searxng.org/admin/settings/index.html
#
# This template is copied to /homeassistant/addons/searxng/settings.yml on
# first start, where you can edit it (e.g. with VS Code). The add-on renders
# it into the runtime configuration on every start, so a restart is required
# after you change this file.
#
# `use_default_settings: true` loads SearXNG's full default configuration
# (including all engines). Only ADD the keys/sections below that you actually
# want to override. Do NOT add empty sections (e.g. a bare "search:" with no
# real keys) — an empty YAML mapping is parsed as `null` and would clobber the
# defaults, breaking SearXNG at startup.

use_default_settings: true

general:
  debug: false
  instance_name: "${SEARXNG_INSTANCE_NAME}"
  donation_url: false
  contact_url: false

server:
  secret_key: "${SEARXNG_SECRET}"
  port: 8080
  bind_address: "0.0.0.0"

  # Public base URL of this instance. When the external_url add-on option is
  # set (e.g. for a reverse proxy), the line below becomes active and uses the
  # configured URL verbatim (e.g. "http://192.168.1.10:8080/" or
  # "https://search.example.com/"). When unset, the line is commented out so
  # SearXNG derives the instance URL from the incoming request.
  ${SEARXNG_BASE_URL}

  # rate limit requests and block some bots. Only enable if you also provide a
  # Redis connection (see the valkey block below).
  limiter: false

  # Proxying über den Pi schützt Privatsphäre & cached Bilder im Arbeitsspeicher
  image_proxy: true

# url is `false` when no Redis is configured (the rate limiter stays off).
# SearXNG runs fine without Redis; only the limiter stays disabled. To enable
# it, configure the redis_host / redis_port / redis_password options and set
# `server.limiter: true` above.
valkey:
  url: ${SEARXNG_REDIS_URL}

search:
  safe_search: 0
  autocomplete: "duckduckgo"
  default_lang: "de"

  # HTML für den Browser, JSON falls du Open WebUI oder Scripts anbindest
  formats:
    - html
    - json

outgoing:
  # Der Pi 5 schaffts locker: Höherer Timeout für langsamere Engines
  request_timeout: 2.5      # Standard ist oft 2.0s
  max_request_timeout: 5.0
  pool_connections: 100
  pool_maxsize: 300
  enable_http2: true

  # Setzt einen Standard-User-Agent, um Captchas von Google/Bing zu reduzieren
  user_agent: "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"

# Remove resource-/network-intensive default engines (ahmia, torch, wikidata):
# they fail to load / initialize on a fresh container and only produce noisy
# errors at startup. Remove the names below if you want to re-enable them.
engines:
  - name: ahmia
    disabled: true
    inactive: true
  - name: torch
    disabled: true
    inactive: true
  - name: wikidata
    disabled: true
    inactive: true

ui:
  static_use_hash: true
  default_theme: simple
  theme_args:
    simple_style: auto