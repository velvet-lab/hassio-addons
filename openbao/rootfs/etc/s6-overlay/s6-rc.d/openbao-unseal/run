#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash

# Set Log Level
bashio::log.level "$(bashio::config 'log_level' 'info')"

# OpenBao API address (local, plain HTTP)
export BAO_ADDR="http://127.0.0.1:8200"

# Persistent folder for secrets
secrets_file="/data/openbao/unseal.keys"
init_endpoint="${BAO_ADDR}/v1/sys/init"

bashio::log.debug "openbao-unseal: start"

# Wait until the OpenBao API is reachable. This Oneshot runs after
# openbao-core (the server) has started and s6 started it, so the server
# should already be up; a short retry loop guards against a slow start.
bashio::log.debug "openbao-unseal: waiting for ${init_endpoint}"
for _ in $(seq 1 30); do
    if curl -fsS "${init_endpoint}" >/dev/null 2>&1; then
        bashio::log.debug "openbao-unseal: API is reachable"
        break
    fi
    sleep 1
done

# Unseal OpenBao using the stored unseal key(s).
if [ ! -f "${secrets_file}" ]; then
    bashio::log.warning "openbao-unseal: no ${secrets_file}, vault stays sealed"
fi

unseal_code=0
#nolint:SC2013
for key in $(grep -i "^Unseal Key" "${secrets_file}" 2>/dev/null | awk '{print $NF}'); do
    bashio::log.debug "openbao-unseal: found key, calling operator unseal"
    bao operator unseal "${key}"
    unseal_code=$?
    bashio::log.debug "openbao-unseal: operator unseal exited with ${unseal_code}"
done

bashio::log.debug "openbao-unseal: done"

# An Oneshot must exit with 0 for s6 to consider it successfully started,
# otherwise s6 aborts the whole service bring-up. The unseal is a one-off
# action; a non-zero CLI return must not stop the add-on from coming up.
exit 0