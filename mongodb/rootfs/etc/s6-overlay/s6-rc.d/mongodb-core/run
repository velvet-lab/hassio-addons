#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community Add-on: MongoDB
# Prepares MongoDb
# ==============================================================================

# Set Log Level
bashio::log.level "$(bashio::config 'log_level' 'warning')"

bashio::log.info "Start MongoDB ..."
exec mongod --config /etc/mongod.conf 

