#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash

# Static, unique build marker. Bump this value on every code change so we can
# verify from the log whether the container image was actually rebuilt and is
# not a stale cache. If the marker is NOT visible in the log, the image is old.
readonly build_marker="searxng-build-v10-config"

root=/data
data_root="$root/searxng"
config_root="$data_root/settings"
settings_file="${config_root}/settings.yml"
secret_file="${data_root}/secret"

default_redis_port="6379"

homeassistant_root="/homeassistant"
user_config_root="$homeassistant_root/addons/searxng"
user_config="$user_config_root/settings.yml"

default_log_level="info"

log_level=$(bashio::config 'log_level' "$default_log_level")
bashio::log.level "${log_level}"

bashio::log.info "SearXNG build marker: ${build_marker}"
bashio::log.info "Prepare SearXNG configuration"

bashio::log.debug "Create folders"
for d in "${config_root}" "${user_config_root}"; do
    if ! bashio::fs.directory_exists "${d}"; then
        bashio::log.debug "Creating directory ${d}"
        mkdir -p "${d}"
        chmod 755 "${d}"
    fi
done

# On first start copy the default configuration to the user-accessible folder
# under /homeassistant, where the user can edit it (e.g. with VS Code). If the
# user deletes the file it is recreated from the bundled template.
if ! bashio::fs.file_exists "${user_config}"; then
    bashio::log.info "Creating default SearXNG configuration for the user"
    cp /etc/default/searxng.template "${user_config}"
    chmod 644 "${user_config}"
fi

# Provide the user-editable limiter configuration. First copy the bundled
# default to the user-visible folder (like settings.yml) so it is easy to edit
# in e.g. VS Code. On every start it is copied into the runtime config folder;
# SearXNG logs a "missing config file: limiter.toml" warning if the runtime
# copy is absent (it is read even when the limiter itself is disabled).
limiter_user="${user_config_root}/limiter.toml"
if ! bashio::fs.file_exists "${limiter_user}"; then
    bashio::log.info "Creating default SearXNG limiter configuration for the user"
    cp /etc/default/limiter.toml "${limiter_user}"
    chmod 644 "${limiter_user}"
fi
# Always copy the (possibly edited) user copy into the runtime config folder so
# edits take effect on restart and the "missing config file" warning is gone.
bashio::log.info "Copying limiter configuration into the runtime folder"
cp "${limiter_user}" "${config_root}/limiter.toml"
chmod 644 "${config_root}/limiter.toml"

# Resolve the Redis connection to use for the limiter / bot protection.
# Redis is OPTIONAL: it is only enabled when a connection is configured. The
# preferred way is to provide the connection via the add-on options
# (redis_host / redis_port / redis_password). As a fallback, a Redis service
# provided by another add-on is used when it is registered and resolves.
redis_host=""
redis_password=""
redis_port=$(bashio::config 'redis_port' "${default_redis_port}")

# 1) add-on options (primary, e.g. for a Redis add-on that does not register a
#    service)
option_host=$(bashio::config 'redis_host')
if bashio::var.has_value "${option_host}"; then
    redis_host="${option_host}"
    redis_password=$(bashio::config 'redis_password')
    bashio::log.info "Using Redis from add-on options at ${redis_host}:${redis_port}"
else
    # 2) a registered Redis service (best effort)
    if bashio::services.available "redis"; then
        service_host=$(bashio::services redis "host")
        if bashio::var.has_value "${service_host}" && [[ "${service_host}" != "null" ]]; then
            redis_host="${service_host}"
            redis_port=$(bashio::services redis "port")
            redis_password=$(bashio::services redis "password")
            bashio::log.info "Using the Redis service provided by Home Assistant"
        fi
    fi
fi

if bashio::var.has_value "${redis_host}"; then
    redis_url="valkey://"
    if bashio::var.has_value "${redis_password}"; then
        redis_url="${redis_url}${redis_password}@"
    fi
    redis_url="${redis_url}${redis_host}:${redis_port}/0"
    bashio::log.info "SearXNG will use Redis at ${redis_host}:${redis_port}"
else
    redis_url="false"
    bashio::log.info "No Redis configured; the SearXNG limiter / bot protection is disabled"
fi
export SEARXNG_REDIS_URL="${redis_url}"

# Determine the host/base URL. Home Assistant exposes the supervisor's network
# info; use the first non-loopback IPv4 as the instance base URL host, falling
# back to the hostname if the API is not reachable.
searxng_host="homeassistant"
if bashio::var.has_value "${SUPERVISOR_TOKEN}"; then
    network_info=$(curl -sSL -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" "http://supervisor/network/info" 2>/dev/null)
    # Best-effort: extract the first IPv4 address (skip loopback and link-local).
    # shellcheck disable=SC2001
    raw_ipv4="$(echo "${network_info}" | sed -E 's/.*"ipv4"[[:space:]]*:?[[:space:]]*\[([^]]*)\].*/\1/' | tr ',' '\n')"
    for candidate in $raw_ipv4; do
        candidate="${candidate//[\" ]/}"
        if [[ -n "${candidate}" ]] && ! [[ "${candidate}" =~ ^(127\.|::1|fe80) ]]; then
            searxng_host="${candidate}"
            break
        fi
    done
fi
if ! [[ -n "${searxng_host}" ]]; then
    searxng_host="homeassistant"
fi
export SEARXNG_HOST="${searxng_host}"

# The web server listens on the internal default port 8080 regardless of
# the port shown in the Home Assistant UI (the UI port is only the exposed
# port). Export it so it can be substituted into `server.base_url` and used
# as the Granian listening port.
export SEARXNG_PORT="8080"

# The server secret key must be stable across restarts (otherwise sessions and
# cookies are invalidated). Generate one on first start and persist it, then
# export it via the container environment so the core service inherits it.
if bashio::fs.file_exists "${secret_file}"; then
    secret_key=$(cat "${secret_file}")
else
    bashio::log.info "Generating a new SearXNG secret key"
    secret_key=$(head -c 32 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 32)
    printf '%s' "${secret_key}" > "${secret_file}"
    chmod 600 "${secret_file}"
fi

bashio::log.debug "Writing container environment variables"
# Write the values used by the settings.yml render into the container
# environment (one file per variable). The actual envsubst runs in
# searxng-core, which re-loads these via with-contenv.
echo -n "${settings_file}" > /var/run/s6/container_environment/SEARXNG_SETTINGS_PATH
echo -n "${secret_key}" > /var/run/s6/container_environment/SEARXNG_SECRET
echo -n "${redis_url}" > /var/run/s6/container_environment/SEARXNG_REDIS_URL
echo -n "${searxng_host}" > /var/run/s6/container_environment/SEARXNG_HOST
echo -n "${SEARXNG_PORT}" > /var/run/s6/container_environment/SEARXNG_PORT
echo -n "0.0.0.0" > /var/run/s6/container_environment/SEARXNG_BIND_ADDRESS
echo -n "0.0.0.0" > /var/run/s6/container_environment/GRANIAN_HOST
echo -n "${SEARXNG_PORT}" > /var/run/s6/container_environment/GRANIAN_PORT
echo -n "searxng" > /var/run/s6/container_environment/GRANIAN_PROCESS_NAME
echo -n "wsgi" > /var/run/s6/container_environment/GRANIAN_INTERFACE
echo -n "4" > /var/run/s6/container_environment/GRANIAN_BLOCKING_THREADS

bashio::log.debug "Redirect log output"
rm -f "${root}/app.err"
ln -s /proc/1/fd/1 "${root}/app.err"

exit 0
