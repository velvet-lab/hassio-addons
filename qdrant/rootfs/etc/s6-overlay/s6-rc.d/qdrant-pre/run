#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash

# Static, unique build marker. Bump this value on every code change so we can
# verify from the log whether the container image was actually rebuilt and is
# not a stale cache. If the marker is NOT visible in the log, the image is old.
readonly build_marker="qdrant-build-v6-config"

root=/data
app_name="qdrant"
homeassistant_root="/homeassistant"
config_source="$homeassistant_root/addons/${app_name}"
config_dest="/etc/${app_name}"
storage_root="$root/${app_name}/storage"
snapshots_root="$root/${app_name}/snapshots"

default_log_level="info"

log_level=$(bashio::config 'log_level' "$default_log_level")
bashio::log.level "${log_level}"

# Map the add-on's syslog-style log level (used by bashio) to the level Qdrant
# understands. The UI option 'log_level' stays syslog-style; only the value
# written into the Qdrant configuration is mapped to Qdrant's own names.
case ${log_level} in
    trace)   qdrant_log_level="TRACE" ;;
    debug)   qdrant_log_level="DEBUG" ;;
    notice)  qdrant_log_level="INFO" ;;
    info)    qdrant_log_level="INFO" ;;
    warning) qdrant_log_level="WARN" ;;
    error)   qdrant_log_level="ERROR" ;;
    fatal)   qdrant_log_level="ERROR" ;;
    *)       qdrant_log_level="INFO" ;;
esac
echo -n "${qdrant_log_level}" > /var/run/s6/container_environment/QDRANT_LOG_LEVEL

bashio::log.info "Qdrant build marker: ${build_marker}"
bashio::log.info "Prepare Qdrant configuration"

# Expose the app identity and config locations via the s6 container
# environment (one file per variable). The core service reads them via
# with-contenv to render and load the configuration.
echo -n "${app_name}" > /var/run/s6/container_environment/APP_NAME
echo -n "${config_source}" > /var/run/s6/container_environment/APP_CONFIG_SOURCE
echo -n "${config_dest}" > /var/run/s6/container_environment/APP_CONFIG_DEST
echo -n "${storage_root}" > /var/run/s6/container_environment/QDRANT_STORAGE_PATH
echo -n "${snapshots_root}" > /var/run/s6/container_environment/QDRANT_SNAPSHOTS_PATH

bashio::log.debug "Create folders"
for folder in "${config_source}" "${config_dest}" "${storage_root}" "${snapshots_root}"; do
    if ! bashio::fs.directory_exists "${folder}"; then
        bashio::log.debug "Creating folder ${folder}"
        mkdir -p "${folder}"
        chmod 755 "${folder}"
    fi
done

# On first start copy the default configuration to the user-accessible
# APP_CONFIG_SOURCE folder (e.g. editable with VS Code). If the user deletes
# the file it is recreated from the bundled template on the next start.
if ! bashio::fs.file_exists "${config_source}/production.yaml"; then
    bashio::log.info "Creating default Qdrant configuration for the user"
    cp /etc/default/production.template "${config_source}/production.yaml"
    chmod 644 "${config_source}/production.yaml"
fi

# The main api_key is a REQUIRED add-on option (HA stores it encrypted).
# Abort if it is empty; never fall back to a generated default.
api_key=$(bashio::config 'api_key')
if ! bashio::var.has_value "${api_key}"; then
    bashio::log.error "The 'api_key' option is required but empty."
    bashio::log.error "Set a strong api key and restart the add-on."
    exit 1
fi

# The read-only api key is optional. When set, it is rendered into the
# Qdrant config; when empty, it renders as explicit YAML null so Qdrant
# treats it as unset (never falls back to the write api_key).
read_only_api_key=$(bashio::config 'read_only_api_key')
if ! bashio::var.has_value "${read_only_api_key}"; then
    read_only_api_key="null"
fi

# Render both keys into the Qdrant config every start (the template uses
# these placeholders; the user-editable source copy never holds the plain
# secret, only the volatile /etc/qdrant/production.yaml gets the values).
echo -n "${api_key}" > /var/run/s6/container_environment/QDRANT_API_KEY
echo -n "${read_only_api_key}" > /var/run/s6/container_environment/QDRANT_READ_ONLY_API_KEY

bashio::log.debug "Redirect log output"
rm -f "${root}/app.err"
ln -s /proc/1/fd/1 "${root}/app.err"

# s6 oneshot services MUST end with exit 0, otherwise s6 treats them as
# "unable to start service ... command exited N" and aborts the whole container
# bring-up (rc.init: fatal: stopping the container).
exit 0
