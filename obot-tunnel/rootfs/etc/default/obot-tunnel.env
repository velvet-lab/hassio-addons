# Obot Tunnel client environment
# This template is copied to /homeassistant/addons/obot-tunnel/obot-tunnel.env
# on first start, where you can edit it. Values of the form ${VAR} are expanded
# from the add-on environment at runtime.
#
# Reference: https://docs.obot.ai/functionality/mcp-tunnels/

# Base URL of the Obot gateway the tunnel client connects to. The command
# converts the Obot URL to the WebSocket endpoint automatically, e.g.
# https://obot.example.com/api connects to wss://obot.example.com/tunnel/connect.
# Comes from the required add-on option 'obot_base_url'.
OBOT_BASE_URL=${OBOT_BASE_URL}

# Tunnel secret (bearer credential) of the MCP tunnel. It is created or rotated
# in the Obot UI (MCP Servers > Tunnels) and shown only once. Comes from the
# required add-on option 'token'.
# OBOT_TUNNEL_TOKEN=${OBOT_TUNNEL_TOKEN}