#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash

# Static, unique build marker. Bump this value on every code change so we can
# verify from the log whether the container image was actually rebuilt and is
# not a stale cache. If the marker is NOT visible in the log, the image is old.
readonly build_marker="rustfs-build-v8-config"

root=/data
app_name="rustfs"
data_root="$root/${app_name}"
log_root="$root/logs"
homeassistant_root="/homeassistant"
config_source="$homeassistant_root/addons/${app_name}"
config_dest="/etc/${app_name}"
env_file="${config_dest}/rustfs.env"
user_config="$config_source/rustfs.env"

default_log_level="info"

log_level=$(bashio::config 'log_level' "$default_log_level")
bashio::log.level "${log_level}"

# Map the add-on's syslog-style log level (used by bashio) to the level the
# RustFS server understands. The UI option 'log_level' stays syslog-style; the
# mapped value overrides RUSTFS_OBS_LOGGER_LEVEL (which the env-file loop below
# would otherwise read from the template).
case ${log_level} in
    trace)   rustfs_log_level="trace" ;;
    debug)   rustfs_log_level="debug" ;;
    notice)  rustfs_log_level="info" ;;
    info)    rustfs_log_level="info" ;;
    warning) rustfs_log_level="warning" ;;
    error)   rustfs_log_level="error" ;;
    fatal)   rustfs_log_level="error" ;;
    *)       rustfs_log_level="info" ;;
esac

bashio::log.info "RustFS build marker: ${build_marker}"
bashio::log.info "Prepare RustFS configuration"

# Expose the app identity and config locations via the s6 container
# environment (one file per variable). The core service reads them via
# with-contenv.
echo -n "${app_name}" > /var/run/s6/container_environment/APP_NAME
echo -n "${config_source}" > /var/run/s6/container_environment/APP_CONFIG_SOURCE
echo -n "${config_dest}" > /var/run/s6/container_environment/APP_CONFIG_DEST

bashio::log.debug "Create folders"
for d in "${config_source}" "${config_dest}" "${log_root}"; do
    if ! bashio::fs.directory_exists "${d}"; then
        bashio::log.debug "Creating directory ${d}"
        mkdir -p "${d}"
        chmod 755 "${d}"
    fi
done

# On first start copy the default configuration to the user-accessible folder
# (APP_CONFIG_SOURCE) under /homeassistant, where the user can edit it (e.g.
# with VS Code). If the user deletes the file it is recreated from the bundled
# template.
if ! bashio::fs.file_exists "${user_config}"; then
    bashio::log.info "Creating default RustFS configuration for the user"
    cp /etc/default/rustfs.env "${user_config}"
    chmod 644 "${user_config}"
fi

# Render the configuration into the volatile APP_CONFIG_DEST folder. This
# happens in pre (not core) because the env-loop below parses the rendered file
# to export the variables into the container environment (documented
# exception).
bashio::log.debug "Render RustFS configuration"
envsubst < "${user_config}" > "${env_file}"
chmod 644 "${env_file}"

# Resolve the credentials from the add-on options. `secret_key` is a REQUIRED
# add-on option (Home Assistant stores it encrypted); RustFS rejects the
# well-known default since 1.0.0-beta.10. Instead of generating a secret on
# first start, abort startup if the user has not provided one.
secret_key=$(bashio::config 'secret_key')

if ! bashio::var.has_value "${secret_key}"; then
    bashio::log.error "The 'secret_key' option is required but empty."
    bashio::log.error "Set a strong random value, e.g. generated with:"
    bashio::log.error "    openssl rand -hex 64"
    bashio::log.error "and restart the add-on."
    exit 1
fi

bashio::log.debug "Export RUSTFS_* environment variables"
while IFS= read -r line; do
    # Skip empty lines and comments
    if bashio::var.has_value "${line}" && [[ "${line}" != \#* ]]; then
        name="${line%%=*}"
        value="${line#*=}"
        # Strip one pair of surrounding double quotes, e.g. RUSTFS_VOLUMES="/data/rustfs"
        if [[ "${value}" == \"*\" ]]; then
            value="${value#\"}"
            value="${value%\"}"
        fi
        bashio::log.debug "  ${name}"
        echo -n "${value}" > "/var/run/s6/container_environment/${name}"
    fi
done < "${env_file}"

# The credentials are exported from the add-on options (overriding the env file,
# which no longer carries them).
bashio::log.debug "Export credentials and console toggle from options"
access_key=$(bashio::config 'access_key' 'admin')
console_enable=$(bashio::config 'console_enable' true)
echo -n "${access_key}" > "/var/run/s6/container_environment/RUSTFS_ACCESS_KEY"
echo -n "${secret_key}" > "/var/run/s6/container_environment/RUSTFS_SECRET_KEY"
echo -n "${console_enable}" > "/var/run/s6/container_environment/RUSTFS_CONSOLE_ENABLE"

# Override the server log level from the UI option (the env-file loop above
# exported the template's RUSTFS_OBS_LOGGER_LEVEL value first).
echo -n "${rustfs_log_level}" > "/var/run/s6/container_environment/RUSTFS_OBS_LOGGER_LEVEL"

# Ensure the data directory exists (RUSTFS_VOLUMES points into it).
if ! bashio::fs.directory_exists "$data_root"; then
    mkdir -p "$data_root"
    chmod 755 "$data_root"
fi

bashio::log.debug "Redirect log output"
rm -f "${root}/app.err"
ln -s /proc/1/fd/1 "${root}/app.err"

exit 0
