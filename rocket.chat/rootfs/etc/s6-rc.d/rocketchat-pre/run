#!/command/with-contenv bashio
ROOT=/data
DATA_ROOT="$ROOT"
ADDON_CONFIG_ROOT=/config

NEW_INSTALL=false
if ! bashio::fs.directory_exists "${DATA_ROOT}/db"; then
    NEW_INSTALL=true
fi

bashio::log.info "Load variables"
ROOTURL=$(bashio::config 'root_url' 'https://localhost:3000') && bashio::log.info 'Root url set'
MONGOURL=$(bashio::config 'mongo_url' 'mongodb://5b838910-mongodb:27017/rocketchat?replicaSet=rs01') && bashio::log.info 'Mongo url set'

bashio::log.debug "Save variables"
echo -n "${NEW_INSTALL}" > /var/run/s6/container_environment/NEW_INSTALL
echo -n "${ROOTURL}" > /var/run/s6/container_environment/ROOTURL
echo -n "${MONGOURL}" > /var/run/s6/container_environment/MONGOURL

bashio::log.debug "Create folders"
mkdir -p "${DATA_ROOT}"
mkdir -p /run/rocketchat

bashio::log.info "Create config file"

bashio::log.debug Redirect log output
rm -f "${ROOT}/app.err"
ln -s /proc/1/fd/1 "${ROOT}/app.err"
