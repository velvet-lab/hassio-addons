#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash

# Set Log Level
bashio::log.level "$(bashio::config 'log_level' 'info')"

bashio::log.info "Starting rustfs server..."

# The volume argument comes from the user-editable RUSTFS_VOLUMES variable,
# exported by rustfs-pre (one file per var via the s6 container environment).
exec /usr/local/bin/rustfs "${RUSTFS_VOLUMES:-/data/rustfs}"
