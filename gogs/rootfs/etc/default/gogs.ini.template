# Gogs server configuration
# This template is copied to /homeassistant/addons/gogs/gogs.ini on first
# start, where you can edit it. It overlays the shipped Gogs defaults, so it
# only needs the keys you actually want to change. Values of the form
# ${VAR} are expanded from the add-on environment at start; Gogs also expands
# any ${VAR} it does not know itself.
#
# Full reference: https://gogs.io/docs/use/configuration.html
#
# IMPORTANT: EXTERNAL_URL below is used for login redirects and clone URLs.
# If you access the add-on from a different host than the one that runs Home
# Assistant, set DOMAIN and EXTERNAL_URL to match the address you use in the
# browser (e.g. https://git.example.com/ if you add a reverse proxy).

# Run as root, matching the user the add-on container runs the process as.
RUN_MODE = prod
RUN_USER = root

[server]
; Gogs listens on this internal address and port regardless of the port
; shown in the Home Assistant UI (the UI port is only the exposed port).
HTTP_ADDR = 0.0.0.0
HTTP_PORT = 3000

; The public URL used by the web UI for redirects and clone URLs.
DOMAIN      = localhost
EXTERNAL_URL = %(PROTOCOL)s://%(DOMAIN)s:%(HTTP_PORT)s/
PROTOCOL    = http

[repository]
ROOT = ${GOGS_REPO_ROOT}

[database]
# SQLite requires an absolute path.
TYPE = sqlite3
PATH = ${GOGS_DATA_PATH}/gogs.db

[security]
# A random per-install key is generated on first start. Change this if you
# want to set your own unguessable value.
SECRET_KEY = ${GOGS_SECRET_KEY}

[security]
# A random per-install key is generated on first start. Change this if you
# want to set your own unguessable value.
SECRET_KEY = ${GOGS_SECRET_KEY}

[session]
# Sessions are kept on disk by default. When the 'redis_enabled' add-on option
# is enabled, PROVIDER switches to "redis" and PROVIDER_CONFIG holds the Redis
# connection string (from the add-on options).
PROVIDER = ${GOGS_SESSION_PROVIDER}
PROVIDER_CONFIG = ${GOGS_SESSION_CONFIG}

[cache]
# The cache adapter defaults to "memory". When 'redis_enabled' is enabled,
# ADAPTER switches to "redis" and HOST holds the Redis connection string.
ADAPTER = ${GOGS_CACHE_ADAPTER}
HOST = ${GOGS_CACHE_HOST}

[cron]
ENABLED = true