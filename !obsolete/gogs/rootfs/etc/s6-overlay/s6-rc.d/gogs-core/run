#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash

# Config locations come from the container environment (set by gogs-pre). They
# are REQUIRED: abort if they are missing instead of falling back to a default.
# shellcheck disable=SC2153  # APP_CONFIG_* / GOGS_CUSTOM are container-env vars set by with-contenv
config_source="${APP_CONFIG_SOURCE:?APP_CONFIG_SOURCE is not set (gogs-pre did not run)}"
config_dest="${GOGS_CUSTOM:?GOGS_CUSTOM is not set (gogs-pre did not run)}"

# Set Log Level
bashio::log.level "$(bashio::config 'log_level' 'info')"

# Render the final Gogs configuration here in the long-run service, where
# with-contenv has injected the s6 container environment (including GOGS_SECRET_KEY
# written by gogs-pre), so envsubst can expand the placeholders.
#
# Gogs loads its configuration from "<GOGS_CUSTOM>/conf/app.ini": the GOGS_CUSTOM
# env var (set in the Dockerfile and exported by gogs-pre) points at the volatile
# config folder, and the file must be placed in a conf/ subdirectory. Gogs then
# finds it automatically, so no --config flag is needed.
bashio::log.debug "Render Gogs configuration"
mkdir -p "${config_dest}/conf"
envsubst < "${config_source}/app.ini" > "${config_dest}/conf/app.ini"
chmod 644 "${config_dest}/conf/app.ini"

bashio::log.info "Start Gogs ..."
exec gogs web