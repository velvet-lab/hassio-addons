if [ ! -f "${HA_CONFIG_ROOT}/register_by_email.html" ]; then
    bashio::log.info "Copy register_by_email.html template"
    cp -f /etc/vocechat/templates/register_by_email.html "${HA_CONFIG_ROOT}"
