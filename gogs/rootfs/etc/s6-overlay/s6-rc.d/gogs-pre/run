#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash

# Static, unique build marker. Bump this value on every code change so we can
# verify from the log whether the container image was actually rebuilt and is
# not a stale cache. If the marker is NOT visible in the log, the image is old.
readonly build_marker="gogs-build-v1-config"

root=/data
gogs_root="$root/gogs"
config_root="$gogs_root/conf"
data_root="$gogs_root/data"
homeassistant_root="/homeassistant"
user_config_root="$homeassistant_root/addons/gogs"
user_config="$user_config_root/gogs.ini"
secret_file="$gogs_root/secret.key"

default_log_level="info"

log_level=$(bashio::config 'log_level' "$default_log_level")
bashio::log.level "${log_level}"

bashio::log.info "Gogs build marker: ${build_marker}"
bashio::log.info "Prepare Gogs configuration"

# Ensure the Gogs custom directory layout exists. The "custom" directory
# location is set via GOGS_CUSTOM in the image and holds conf/, data/ and log/.
bashio::log.debug "Create folders"
for folder in "${config_root}" "${data_root}" "${user_config_root}"; do
    if ! bashio::fs.directory_exists "${folder}"; then
        bashio::log.debug "Creating folder ${folder}"
        mkdir -p "${folder}"
        chmod 755 "${folder}"
    fi
done

# Gogs refuses to start while SECRET_KEY uses the default value. Persist a
# generated secret on the first start so sessions and cookies survive a
# restart. The user can override it with the `secret_key` add-on option, or by
# editing the rendered app.ini directly.
if ! bashio::fs.file_exists "${secret_file}"; then
    bashio::log.info "Generating a new Gogs SECRET_KEY"
    secret_key=$(cat /dev/urandom | tr -dc 'a-zA-Z0-9' | head -c 64)
    printf '%s' "${secret_key}" > "${secret_file}"
    chmod 600 "${secret_file}"
    unset secret_key
fi

# The `secret_key` add-on option overrides the generated/persisted key.
if bashio::var.has_value "$(bashio::config 'secret_key')"; then
    bashio::log.debug "Using the secret_key from the add-on configuration"
    echo -n "$(bashio::config 'secret_key')" > /var/run/s6/container_environment/GOGS_SECRET_KEY
else
    bashio::log.debug "Using the generated, persisted SECRET_KEY"
    echo -n "$(cat "${secret_file}")" > /var/run/s6/container_environment/GOGS_SECRET_KEY
fi

# On first start copy the default configuration to the user-accessible folder
# under /homeassistant, where the user can edit it (e.g. with VS Code). If the
# user deletes the file it is recreated from the bundled template.
if ! bashio::fs.file_exists "${user_config}"; then
    bashio::log.info "Creating default Gogs configuration for the user"
    cp /etc/default/gogs.ini.template "${user_config}"
    chmod 644 "${user_config}"
fi

# The web server port is read from the add-on configuration so it matches the
# port shown in the Home Assistant UI. Gogs expands this placeholder itself
# from the process environment at start.
echo -n "$(bashio::addon.port '3000/tcp')" > /var/run/s6/container_environment/GOGS_PORT

# Copy the user-edited configuration to the Gogs custom conf folder. Any
# remaining ${PLACEHOLDER} values are left intact for Gogs to expand from the
# environment at startup.
bashio::log.debug "Write Gogs configuration"
cp "${user_config}" "${config_root}/app.ini"
chmod 644 "${config_root}/app.ini"

bashio::log.debug "Redirect log output"
rm -f "${root}/app.err"
ln -s /proc/1/fd/1 "${root}/app.err"